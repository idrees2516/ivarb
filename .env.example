# IVARB environment overrides (all optional)

# Underlyings to scan (any symbol the venues list; SOL adds ~1-2k instruments)
IVARB_UNDERLYINGS=BTC,ETH,SOL

# Signal thresholds (vol points)
IVARB_MIN_NET_VP=0.5
IVARB_EXIT_VP=0.25

# Freshness (ms)
IVARB_STALE_MS=45000
IVARB_RETIRE_MS=180000

# Venue enable list (default: all)
# IVARB_VENUES=deribit,okx,bybit,binance,delta,aevo,derive,thalex

# Simulation feed: auto (fallback) | always | off
IVARB_SIM=auto

# ---- millisecond pipeline cadences (ms) ----
# WS delta push (1 = every millisecond the engine has news)
IVARB_BROADCAST_MS=1
IVARB_SWEEP_MS=250
IVARB_SNAPSHOT_MS=1000
# Multi-hop route scan + per-opp analytics pass (chunked: <=120 families/pass)
IVARB_MULTIHOP_MS=250
# Hold-to-expiry stats refresh per opportunity
IVARB_HOLDS_MS=500

# ---- genetic optimizer ----
IVARB_GA_ENABLED=true
IVARB_GA_APPLY=true
# ms per generation (15s default; fitness replays the tape)
IVARB_GA_GEN_MS=15000

# ---- advantage taker cadences (ms) ----
# Scan tick: the taker fires the moment fresh engine news lands (event-driven
# burst); this is the tick granularity, clamped to [10, 1000].
IVARB_EXEC_SCAN_MS=25
IVARB_EXEC_MONITOR_MS=1000
IVARB_EXEC_PUSH_MS=750

# ---- advantage taker behavior ----
# Risk profile: conservative | balanced | aggressive | sniper
IVARB_PROFILE=balanced
# Auto-arm at boot in paper mode (the taker immediately starts taking every
# opportunity that passes the risk gates). Live mode NEVER auto-arms.
IVARB_AUTOARM=1

# Audit log directory
IVARB_DATA_DIR=./data

# Server bind
PORT=3000
BIND=0.0.0.0

# Static frontend directory (defaults to ./frontend/dist; the Docker image
# sets this to /opt/ivarb/www)
# IVARB_STATIC_DIR=/opt/ivarb/www

# Logging
RUST_LOG=info

# ---- LIVE execution on real exchanges ----
# The arming chain (ALL must hold, otherwise every fill is paper):
#   1. IVARB_MODE=live
#   2. venue credentials below
#   3. IVARB_LIVE_CONFIRM=yes   (explicit acknowledgement that real orders
#      will be placed)
# Doctrine: a venue WITHOUT a gateway refuses live legs (a simulated leg
# inside a live attempt is forbidden), so add credentials for every venue
# your routes touch.
# IVARB_MODE=live
# IVARB_LIVE_CONFIRM=yes

# Deribit (WebSocket, client-credentials auth; point DERIBIT_WS_URL at
# wss://test.deribit.com/ws/api/v2 to rehearse on testnet for free)
# DERIBIT_API_KEY=...
# DERIBIT_API_SECRET=...
# DERIBIT_WS_URL=wss://www.deribit.com/ws/api/v2

# Bybit (V5 REST, HMAC-SHA256; unified account; options + linear perp hedges)
# BYBIT_API_KEY=...
# BYBIT_API_SECRET=...

# OKX (v5 REST, HMAC-SHA256 + passphrase; options + SWAP perp hedges)
# OKX_API_KEY=...
# OKX_API_SECRET=...
# OKX_API_PASSPHRASE=...

# Binance European options (eapi REST, HMAC query signing; no perp hedging
# on this venue - hedges stay refused in live mode there)
# BINANCE_API_KEY=...
# BINANCE_API_SECRET=...

# ---- LIVE execution on real chains (EVM / Uniswap V3) ----
# Raw 32-byte hex private key of the wallet that signs + broadcasts swaps.
# WITHOUT it the gateway still quotes real pool prices and builds the exact
# ready-to-broadcast calldata (shown in the side panel); WITH it the CHAIN
# SWAP button broadcasts a real EIP-1559 transaction (approve + swap).
# Use a dedicated hot wallet with only the funds you intend to trade.
# IVARB_CHAIN_SIGNER_KEY=0x...
# Slippage floor for on-chain swaps (basis points; default 50 = 0.5%)
# IVARB_CHAIN_SLIPPAGE_BPS=50
# Private RPC overrides (public defaults are rate-limited)
# IVARB_RPC_BASE=https://mainnet.base.org
# IVARB_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
# IVARB_RPC_OPTIMISM=https://mainnet.optimism.io
# IVARB_RPC_ETHEREUM=https://eth.drpc.org


# ---- agentic research plane (Section R) ----
# Optional LLM brain for the research agent (any OpenAI-compatible endpoint).
# Without these the deterministic "desk" brain is used (zero-config).
# IVARB_LLM_BASE_URL=https://api.openai.com/v1
# IVARB_LLM_API_KEY=
# IVARB_LLM_MODEL=gpt-4o-mini
# IVARB_LLM_MAX_STEPS=6
# Paradex TradeOptions quotes: ZERO CONFIG. They stream from Paradex's
# public WebSocket (SBE `markets_summary.ALL` channel) — unauthenticated, no
# JWT, nothing to set. (The old PARADEX_JWT env is gone: Paradex JWTs expire
# every 5 minutes by design and cannot be extended, so the public feed
# replaces them entirely.)
